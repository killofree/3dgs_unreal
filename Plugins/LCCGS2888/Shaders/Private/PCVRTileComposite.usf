 if(lane==0){TerminatedPixels=0;
#if GS_TILE_WAVE_MASK
 MaskWaveValid=1;MaskNextWave=0;
#if GS_TILE_PROBE == 9
 MaskFailureReasons=0;MaskMismatchLanes=0;
#endif
#endif
 }
 uint runs=(n+8191)/8192;
#if GS_TILE_DENSE_MERGE
 uint2 denseMeta=TileDenseMeta[tile];bool denseMerged=n>8192 && denseMeta.y!=0;if(denseMerged)runs=1;
#endif
 if(TileAblation==5)runs=1;
 for(uint i=lane;i<runs;i+=256)RunHeads[i]=TileFrontToBack!=0?min(n,(i+1)*8192):i*8192;
 GroupMemoryBarrierWithGroupSync();
