 if(lane==0){TileProfileData[meta]=n;TileProfileData[meta+1]=runs;TileProfileData[meta+2]=(n+31)/32;
 TileProfileData[meta+3]=mergeReads;TileProfileData[meta+4]=rectangleTests;TileProfileData[meta+5]=maskHits;
 TileProfileData[meta+6]=sampleY*16+sampleX;TileProfileData[meta+7]=validW*validH;
 TileProfileData[meta+25]=cachedEntries;TileProfileData[meta+26]=recheckEntries;for(uint rz=29;rz<32;++rz)TileProfileData[meta+rz]=0;}
 if(samplePixel){TileProfileData[meta+27]=pc[17];TileProfileData[meta+28]=pc[18];pc[15]=terminated?1:0;pc[16]=asuint(color.a);for(uint z=0;z<17;++z)TileProfileData[meta+8+z]=pc[z];}
