struct TileViewData {
 float4 ClipPosition; float3 TranslatedWorldPos; float Pad;
 uint ColorRG; uint ColorBA; uint DirectRG; uint DirectBA;
 float2 Axis1; float2 Axis2; uint Cluster; uint Padding; uint TransmissionRG; uint TransmissionBA;
};
struct TileRecord { float4 CenterInverse0; float4 Inverse1Depth; float4 Color; uint4 Bounds; };
// Storage only: production color/fog are already half-rounded before this store.
// Preserve nearest depth as FP32. Never enable with unrounded output.
#if GS_TILE_PACKED_OUTPUT
struct TilePixel { uint4 Packed; };
#else
struct TilePixel { float4 Color; float4 DepthFog; };
#endif
TilePixel MakeTilePixel(float4 color,float depth,float fog){
 TilePixel p;
#if GS_TILE_PACKED_OUTPUT
 p.Packed=uint4(f32tof16(color.r)|(f32tof16(color.g)<<16),f32tof16(color.b)|(f32tof16(color.a)<<16),asuint(depth),f32tof16(fog));
#else
 p.Color=color;p.DepthFog=float4(depth,fog,0,0);
#endif
 return p;
}
void DecodeTilePixel(TilePixel p,out float4 color,out float depth,out float fog){
#if GS_TILE_PACKED_OUTPUT
 uint4 v=p.Packed;
 color=float4(f16tof32(v.x&65535),f16tof32(v.x>>16),f16tof32(v.y&65535),f16tof32(v.y>>16));
 depth=asfloat(v.z);fog=f16tof32(v.w&65535);
#else
 color=p.Color;depth=p.DepthFog.x;fog=p.DepthFog.y;
#endif
}
StructuredBuffer<TileViewData> TileViewDataBuffer TILE_REG(t0);
StructuredBuffer<uint> TileSortKeys TILE_REG(t1);
StructuredBuffer<uint> TileDrawArgs TILE_REG(t2);
StructuredBuffer<float4> TileFinalColors TILE_REG(t3);
Texture2D<float> TileSceneDepth TILE_REG(t4);
RWStructuredBuffer<TileRecord> TileRecords TILE_REG(u0);
RWStructuredBuffer<uint> TileCounts TILE_REG(u1);
RWStructuredBuffer<uint> TileOffsets TILE_REG(u2);
RWStructuredBuffer<uint> TileCursors TILE_REG(u3);
RWStructuredBuffer<uint> TileEntries TILE_REG(u4);
RWStructuredBuffer<TilePixel> TilePixels TILE_REG(u5);
