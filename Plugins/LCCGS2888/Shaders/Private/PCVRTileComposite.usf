#if GS_TILE_STAGE == 17
[numthreads(16,16,1)]
void AuditReadCS(uint3 id:SV_DispatchThreadID){
 if(any(id.xy>=uint2(TileWidth,TileHeight)))return;
 uint index=id.y*TileWidth+id.x;uint4 color;uint depth,fog;
#if GS_TILE_PROBE == 8
 uint4 v=TileAuditPacked[index];
 color=asuint(float4(f16tof32(v.x&65535),f16tof32(v.x>>16),f16tof32(v.y&65535),f16tof32(v.y>>16)));
 depth=v.z;fog=asuint(f16tof32(v.w&65535));
#else
 float4 c;float d,f;DecodeTilePixel(TilePixels[index],c,d,f);color=asuint(c);depth=asuint(d);fog=asuint(f);
#endif
 // Read all six meaningful output components with a common observable write.
 TileAuditDigest[index]=color.x^(color.y*3u)^(color.z*5u)^(color.w*7u)^(depth*11u)^(fog*13u);
}
#endif
#if GS_RESOLVE_PART == 4 || GS_RESOLVE_PART == 5
[numthreads(64,1,1)]
void CostReplayCS(uint3 id:SV_DispatchThreadID){
 uint selected=id.x,tiles=TileCountX*TileCountY,selectedCount=(tiles+15)/16;if(selected>=selectedCount)return;
 uint tile=selected*16+(TileProfileSeed&15u);uint digest=2166136261u;
 if(tile<tiles){
  uint2 group=uint2(tile%TileCountX,tile/TileCountX);
  uint validW=min(16u,TileWidth-group.x*16),validH=min(16u,TileHeight-group.y*16);
  uint sample=CostSampleIndex(tile,TileProfileSeed,validW,validH);
  float2 pixel=float2(group*16+uint2(sample%validW,sample/validW))+.5;
  uint count=TileCostMeta[selected].x;
  float k=TileQuality==3?5.15:4.0,edge=exp(-k);
  for(uint i=0;i<count;++i){uint4 entry=TileCostTrace[selected*1024+i];
   float d2=0,alpha=0;
   if(entry.y>=1){
#if GS_RESOLVE_PART == 4
    TileRecord r=TileRecords[entry.x];float2 delta=pixel-r.CenterInverse0.xy;
    float2 q=float2(dot(delta,r.CenterInverse0.zw),dot(delta,r.Inverse1Depth.xy));d2=dot(q,q);
    if(entry.y>=2)alpha=saturate((exp(-k*d2)-edge)/max(1-edge,.0001)*r.Color.a);
#else
    d2=asfloat(entry.z);if(entry.y>=2)alpha=asfloat(entry.w);
#endif
   }
   // Identical recorded control and observable sink; cached read is not free.
   digest=(digest*16777619u)^entry.x^(entry.y*7u)^asuint(d2)^(asuint(alpha)*13u);
  }
 }
#if GS_RESOLVE_PART == 4
 TileCostDigest[selected].x=digest;
#else
 TileCostDigest[selected].y=digest;
#endif
}
#endif

void AuditUnusedTerminator(){
}
// Explicit empty output; never expose a stale/uninitialized pixel buffer.
[numthreads(16,16,1)]
void EmptyPixelsCS(uint3 group:SV_GroupID,uint3 local:SV_GroupThreadID){
 uint2 pixel=group.xy*16+local.xy;
 if(all(pixel<uint2(TileWidth,TileHeight))){TilePixels[pixel.y*TileWidth+pixel.x]=MakeTilePixel(0,4398046511104.0,0);}
 if(all(group==0)&&all(local==0)){TileRasterArgs[0]=6;TileRasterArgs[1]=0;TileRasterArgs[2]=0;TileRasterArgs[3]=0;TileRasterArgs[4]=0;}
}

#if !defined(GS_TILE_NATIVE) || defined(GS_TILE_NATIVE_PIXEL)
#ifdef GS_TILE_NATIVE_PIXEL
StructuredBuffer<TilePixel> TileResolvedPixels : register(t5);
StructuredBuffer<uint> TileOutputStats : register(t6);
#else
StructuredBuffer<TilePixel> TileResolvedPixels;
StructuredBuffer<uint> TileOutputStats;
#endif
float4 TileVS(uint id:SV_VertexID):SV_Position {
 float2 uv=float2((id<<1)&2,id&2);return float4(uv*float2(2,-2)+float2(-1,1),1,1);
}
struct TileTargets {float4 Color:SV_Target0;float Depth:SV_Target1;float4 Fog:SV_Target2;};
TileTargets TilePS(float4 position:SV_Position){
 if(TileOutputStats[0]>TileEntryCapacity || TileOutputStats[6]!=0 || TileOutputStats[7]!=0)discard;
 uint2 pixel=uint2(position.xy)-uint2(TileOriginX,TileOriginY);
 TilePixel p=TileResolvedPixels[pixel.y*TileWidth+pixel.x];
 float4 color;float depth,fog;DecodeTilePixel(p,color,depth,fog);
 TileTargets o;o.Color=color;o.Depth=depth;o.Fog=float4(fog,0,0,0);return o;
}
#endif

#ifdef GS_TILE_STAGE
#if GS_TILE_STAGE == 18
[numthreads(64,1,1)] void MainCS(uint3 id:SV_DispatchThreadID){CostReplayCS(id);}
#elif GS_TILE_STAGE == 17
[numthreads(16,16,1)] void MainCS(uint3 id:SV_DispatchThreadID){AuditReadCS(id);}
#elif GS_TILE_STAGE == 14
[numthreads(1,1,1)] void MainCS(uint3 id:SV_DispatchThreadID){CooperativeArgsCS(id);}
#elif GS_TILE_STAGE == 15 || GS_TILE_STAGE == 16
[numthreads(32,1,1)] void MainCS(uint3 g:SV_GroupID,uint lane:SV_GroupIndex){
#if GS_TILE_STAGE == 15
 CooperativeRegisterCS(g,lane);
#else
 CooperativeEmitCS(g,lane);
#endif
}
#elif GS_TILE_STAGE == 6 || GS_TILE_STAGE == 13
[numthreads(16,16,1)]
void MainCS(uint3 g:SV_GroupID,uint3 l:SV_GroupThreadID,uint lane:SV_GroupIndex){
#if GS_TILE_STAGE == 13
EmptyPixelsCS(g,l);
#else
#if GS_TILE_REGION_LIST
 uint tile=g.y*TileCountX+g.x;uint4 meta=TileRegionMeta[tile];uint n=TileCounts[tile],offset=TileOffsets[tile];
 bool ready=n>32 && n<=8192 && (meta.x&0x80000000u)!=0 && all((meta&uint4(0x7fffffffu,0xffffffffu,0xffffffffu,0xffffffffu))<=n) && TileStats[6]==0 && TileStats[7]==0 && TileStats[0]<=TileEntryCapacity && offset<=TileRegionCapacity/4 && n<=TileRegionCapacity/4-offset;
 if(ready)ResolveRegionCS(g,l,lane,meta);else ResolveCS(g,l,lane);
#else
 ResolveCS(g,l,lane);
#endif
#endif
}
#else
#if GS_TILE_STAGE == 5 && GS_TILE_SORT_BUCKET == 1
[numthreads(32,1,1)]
#else
[numthreads(256,1,1)]
#endif
void MainCS(uint3 id:SV_DispatchThreadID,uint3 g:SV_GroupID,uint lane:SV_GroupIndex){
#if GS_TILE_STAGE == 0
ClearCS(id);
#elif GS_TILE_STAGE == 1
BuildCS(id);
#elif GS_TILE_STAGE == 2
PrefixCS(id,lane);
#elif GS_TILE_STAGE == 3
EmitCS(id);
#elif GS_TILE_STAGE == 4
ValidateCS(id);
#elif GS_TILE_STAGE == 5
SortCS(g,lane);
#elif GS_TILE_STAGE == 7
BuildCS(id);
#elif GS_TILE_STAGE == 8
RegisterCS(id);
#elif GS_TILE_STAGE == 9
EmitCS(id);
#elif GS_TILE_STAGE == 10
BoundsCS(g,lane);
#elif GS_TILE_STAGE == 11
#if GS_TILE_DENSE_MERGE
DensePrefixCS(lane);
#endif
#elif GS_TILE_STAGE == 12
#if GS_TILE_DENSE_MERGE
DenseMergeCS(g,lane);
#endif
#endif
}
#endif
#endif




