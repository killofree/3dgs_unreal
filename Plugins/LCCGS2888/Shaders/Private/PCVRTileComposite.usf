#if GS_RESOLVE_PART == 1
 uint recordHash=2166136261u;
#endif
#if GS_RESOLVE_PART == 3
 uint validWidth=min(16u,TileWidth-group.x*16),validHeight=min(16u,TileHeight-group.y*16);
 uint sampled=CostSampleIndex(tile,TileProfileSeed,validWidth,validHeight);
 bool costSample=(tile&15u)==(TileProfileSeed&15u) && valid && local.x==sampled%validWidth && local.y==sampled/validWidth;
