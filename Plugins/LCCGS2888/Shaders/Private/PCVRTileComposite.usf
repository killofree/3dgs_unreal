 // Uniform group decision. Non-32-lane devices keep the original barriers.
 fusedBatch=useWaveMasks && (TileSubtileCull!=0 || GS_TILE_BATCH_SKIP!=0);
#endif
 float sceneZ=valid?TileSceneDepth.Load(int3(pixel+uint2(TileOriginX,TileOriginY),0)):1;
 float4 color=0;float nearest=4398046511104.0,fog=0,transmission=1;bool terminated=false;
 float2 bounds=asfloat(TileBoundsLimits[tile]);
 float k=TileQuality==3?5.15:4.0,edge=exp(-k);
 for(uint base=0;base<n;base+=32){
  uint batchSize=min(32,n-base);
  if(runs>1){
   if(lane==0)for(uint j=0;j<batchSize;++j){
    uint best=TileFrontToBack!=0?0:0xffffffff,bestRun=0;bool found=false;
    for(uint k=0;k<runs;++k){uint head=RunHeads[k];bool available=TileFrontToBack!=0?head>k*8192:head<min(n,(k+1)*8192);
     if(available){
