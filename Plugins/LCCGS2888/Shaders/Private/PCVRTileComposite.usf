     ++mergeReads;
#endif
     uint slot=TileEntries[offset+(TileFrontToBack!=0?head-1:head)];if(!found || (TileFrontToBack!=0?slot>best:slot<best)){best=slot;bestRun=k;found=true;}}}
    MergedSlots[j]=best;if(TileFrontToBack!=0)--RunHeads[bestRun];else ++RunHeads[bestRun];
   }
   GroupMemoryBarrierWithGroupSync();
  }
  if(!fusedBatch){
  if(lane<batchSize){uint slot;
#if GS_TILE_DENSE_MERGE
   if(denseMerged)slot=TileDenseEntries[denseMeta.x+(TileFrontToBack!=0?n-1-base-lane:base+lane)];else
