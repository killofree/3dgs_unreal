RWStructuredBuffer<uint4> TileAuditMasks TILE_REG(u17);
#endif
#if GS_TILE_PROBE == 6 || GS_TILE_PROBE == 8
RWStructuredBuffer<uint4> TileAuditPacked TILE_REG(u18);
#endif
#if GS_TILE_STAGE == 17 || GS_TILE_PROBE == 9
RWStructuredBuffer<uint> TileAuditDigest TILE_REG(u19);
#endif
