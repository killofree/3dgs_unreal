RWStructuredBuffer<uint4> TileCostTrace TILE_REG(u24);
RWStructuredBuffer<uint4> TileCostMeta TILE_REG(u25);
RWStructuredBuffer<uint2> TileCostDigest TILE_REG(u26);
uint CostSampleIndex(uint tile,uint seed,uint width,uint height){
 uint h=seed*747796405u+2891336453u;
 h=((h>>((h>>28u)+4u))^h)*277803737u;h=(h>>22u)^h;
 return (tile*1664525u+h*1013904223u)%(width*height);
}
#endif
uint DensityClass(uint n){return n==0?6:n<=32?1:n<=256?2:n<=1024?3:n<=8192?4:5;}
bool DensitySelected(uint n){return TileDensityClass==0 || TileDensityClass==DensityClass(n);}
