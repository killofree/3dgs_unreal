  if(lane<batchSize){TileRecord r=LoadBatch(lane);uint4 a=asuint(r.CenterInverse0),b=asuint(r.Inverse1Depth),c=asuint(r.Color),d=r.Bounds;
   recordHash=(recordHash*16777619u)^a.x^(a.y*3u)^(a.z*5u)^(a.w*7u)^b.x^(b.y*11u)^(b.z*13u)^(b.w*17u)^c.x^(c.y*19u)^(c.z*23u)^(c.w*29u)^d.x^(d.y*31u)^(d.z*37u)^(d.w*41u);}
