RWStructuredBuffer<uint> TileRasterArgs TILE_REG(u7);
RWStructuredBuffer<uint2> TileBoundsLimits TILE_REG(u8);
RWStructuredBuffer<uint> TileMembershipMasks TILE_REG(u9);
// TileDrawArgs is an immutable GPU copy for this dispatch chain.
RWStructuredBuffer<uint> TileFrozenDrawArgs TILE_REG(u10);
#if GS_TILE_COUNTERS
RWStructuredBuffer<uint> TileProfileData TILE_REG(u11);
#define PC_INC(i) if(samplePixel) pc[i]++
void GSStatus(uint slot,uint status,uint area,uint hits,uint cached) {
 if((slot&255u)==(TileProfileSeed&255u)){
  uint at=16+(slot>>8)*4;TileProfileData[at]=status;TileProfileData[at+1]=area;
  TileProfileData[at+2]=hits;TileProfileData[at+3]=cached;
 }
}
#else
#define PC_INC(i)
#endif
